# Строка подключения к PostgreSQL.
# Пароль здесь — плейсхолдер, реальный держите в backend/.env (он не коммитится).
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/TanymTor

# Источник оценок: db (из базы) или demo (генерируется на лету).
GRADE_SOURCE=db

# Секрет для JWT. Сгенерируйте свой для продакшена.
JWT_SECRET=change-me-in-production

# Готовые аккаунты после seed:
# учитель  teacher@tanymtor.kz / teacher123
# админ    admin@tanymtor.kz  / admin123

FRONTEND_ORIGIN=http://localhost:3000

PORT=4000
